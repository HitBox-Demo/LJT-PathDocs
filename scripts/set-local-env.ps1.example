# Copy to set-local-env.ps1, edit the password, and keep the real file out of Git.
# Keep demo mode true while verifying the JDBC connection page.

$env:DMS_DEMO_MODE = "true"
$env:DMS_DB_URL = "jdbc:oracle:thin:@//localhost:1521/XEPDB1"
$env:DMS_DB_USERNAME = "LJT_ROUTE_FLOW"
$env:DMS_DB_PASSWORD = "CHANGE_ME"
$env:DMS_STORAGE_ROOT = "C:\LJTRouteFlowStorage"
$env:DMS_MAX_FILE_MB = "20"
$env:DMS_DB_CONNECT_TIMEOUT_MS = "10000"
$env:DMS_DB_READ_TIMEOUT_MS = "30000"
