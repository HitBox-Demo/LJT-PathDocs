<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
        version="4.0">
    <display-name>LJT RouteFlow Document Management System</display-name>


    <filter><filter-name>SecurityHeadersFilter</filter-name><filter-class>com.chekrol.dms.filter.SecurityHeadersFilter</filter-class></filter>
    <filter-mapping><filter-name>SecurityHeadersFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

    <filter><filter-name>EncodingFilter</filter-name><filter-class>com.chekrol.dms.filter.EncodingFilter</filter-class></filter>
    <filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

    <filter><filter-name>FlashFilter</filter-name><filter-class>com.chekrol.dms.filter.FlashFilter</filter-class></filter>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/app/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/documents/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/approvals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/notifications/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>FlashFilter</filter-name><url-pattern>/setup/*</url-pattern></filter-mapping>

    <filter><filter-name>AuthenticationFilter</filter-name><filter-class>com.chekrol.dms.filter.AuthenticationFilter</filter-class></filter>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/app/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/documents/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/approvals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/department/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/notifications/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/setup/*</url-pattern></filter-mapping>

    <filter><filter-name>AuthorizationFilter</filter-name><filter-class>com.chekrol.dms.filter.AuthorizationFilter</filter-class></filter>
    <filter-mapping><filter-name>AuthorizationFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthorizationFilter</filter-name><url-pattern>/approvals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthorizationFilter</filter-name><url-pattern>/department/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthorizationFilter</filter-name><url-pattern>/documents/create</url-pattern></filter-mapping>

    <filter><filter-name>CsrfFilter</filter-name><filter-class>com.chekrol.dms.filter.CsrfFilter</filter-class></filter>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/documents/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/approvals/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/notifications/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/logout</url-pattern></filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <resource-ref>
        <description>Oracle datasource for LJT RouteFlow</description>
        <res-ref-name>jdbc/DocumentManagementDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page><error-code>403</error-code><location>/WEB-INF/views/errors/403.jsp</location></error-page>
    <error-page><error-code>404</error-code><location>/WEB-INF/views/errors/404.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/WEB-INF/views/errors/500.jsp</location></error-page>

    <mime-mapping><extension>webmanifest</extension><mime-type>application/manifest+json</mime-type></mime-mapping>
</web-app>
